# Fallback secret for both anonymous hashing and cookie signing, used only where the
# more specific keys below are unset. MUST be a long random value in production:
# changing it invalidates existing rate limits and logs everyone out of paid views.
LINKEDOUT_SALT=change-me-to-something-long-and-random

# Optional, and preferred over LINKEDOUT_SALT once you set it: separate secrets for
# hashing (poster identities, echo voters, subscriber emails) and cookie signing
# (entitlement + moderator sessions). One deployment secret is fine to start with —
# LINKEDOUT_SALT covers both — but a leak of one no longer compromises the other once
# these are set independently.
LINKEDOUT_HASH_KEY=
LINKEDOUT_COOKIE_SECRET=

# Where the SQLite file lives. Fine as-is for local dev.
LINKEDOUT_DB=./data/linkedout.db

# How many reverse proxies sit between the internet and this app and can be trusted to
# append their own hop to x-forwarded-for (and strip any client-sent cf-connecting-ip /
# x-real-ip). Defaults to 0 — trust nothing — because an unsafe default here is a
# security hole (a direct caller mints a fresh identity every request), not just a
# usability regression. Set to 1 for a single edge/proxy in front (Vercel, one nginx or
# Cloudflare) — but only if you have actually confirmed that edge strips client-sent
# copies of these headers before forwarding. This backs the daily post cap,
# one-echo-per-person, and the report threshold — get it wrong in the trusting
# direction and all three become bypassable.
LINKEDOUT_TRUSTED_PROXIES=0

# Stripe Payment Links. When set, /api/checkout redirects to Stripe instead of
# collecting a waitlist email. Leave blank until you are ready to charge.
STRIPE_CANDIDATE_LINK=
STRIPE_EMPLOYER_LINK=

# Grants paid access without payment. Local demos only — never set this in production.
LINKEDOUT_DEMO_UNLOCK=

# Shared token for the moderation queue at /admin. Leave UNSET and there is no admin
# surface at all — the route 404s. Set it to a long random string to enable moderation:
#   openssl rand -base64 32
# Rotating LINKEDOUT_SALT (or LINKEDOUT_COOKIE_SECRET, if set) also signs out every
# moderator, which is the fast revoke.
LINKEDOUT_ADMIN_TOKEN=
